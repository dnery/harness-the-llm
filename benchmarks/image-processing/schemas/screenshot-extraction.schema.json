{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScreenshotExtraction",
  "type": "object",
  "required": [
    "schema_version",
    "target_id",
    "page_identity",
    "viewport",
    "layout_regions",
    "navigation",
    "content_items",
    "structured_data",
    "visual_elements",
    "quality_flags",
    "one_sentence_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "image-processing-benchmark/v1"
    },
    "target_id": {
      "type": "string"
    },
    "page_identity": {
      "type": "object",
      "required": ["site", "page_title", "visible_url_or_domain", "confidence"],
      "properties": {
        "site": { "type": ["string", "null"] },
        "page_title": { "type": ["string", "null"] },
        "visible_url_or_domain": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "viewport": {
      "type": "object",
      "required": ["browser_chrome_visible", "apparent_scroll_position", "major_occlusions", "legibility"],
      "properties": {
        "browser_chrome_visible": { "type": "boolean" },
        "apparent_scroll_position": { "enum": ["top", "middle", "bottom", "unknown"] },
        "major_occlusions": { "type": "array", "items": { "type": "string" } },
        "legibility": { "enum": ["excellent", "good", "mixed", "poor"] }
      },
      "additionalProperties": false
    },
    "layout_regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/layout_region" }
    },
    "navigation": {
      "type": "object",
      "required": ["primary_items", "secondary_items", "search_or_filter_controls"],
      "properties": {
        "primary_items": { "type": "array", "items": { "type": "string" } },
        "secondary_items": { "type": "array", "items": { "type": "string" } },
        "search_or_filter_controls": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "content_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/content_item" }
    },
    "structured_data": {
      "type": "object",
      "required": ["tables", "repeated_lists"],
      "properties": {
        "tables": {
          "type": "array",
          "items": { "$ref": "#/$defs/table" }
        },
        "repeated_lists": {
          "type": "array",
          "items": { "$ref": "#/$defs/repeated_list" }
        }
      },
      "additionalProperties": false
    },
    "visual_elements": {
      "type": "array",
      "items": { "$ref": "#/$defs/visual_element" }
    },
    "quality_flags": {
      "type": "array",
      "items": { "$ref": "#/$defs/quality_flag" }
    },
    "one_sentence_summary": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 100 }
    },
    "layout_region": {
      "type": "object",
      "required": ["id", "label", "role", "bbox_pct", "summary", "visible_text_fragments", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "role": {
          "enum": ["navigation", "sidebar", "article", "infobox", "table", "card_list", "code", "media", "ad", "dialog", "footer", "other"]
        },
        "bbox_pct": { "$ref": "#/$defs/bbox" },
        "summary": { "type": "string" },
        "visible_text_fragments": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "content_item": {
      "type": "object",
      "required": ["rank", "region_id", "type", "text", "numeric_values", "visual_evidence", "confidence"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "region_id": { "type": ["string", "null"] },
        "type": {
          "enum": ["heading", "paragraph", "card", "repository", "article_link", "fact", "stat", "control", "image", "code", "other"]
        },
        "text": { "type": ["string", "null"] },
        "numeric_values": { "type": "array", "items": { "type": "string" } },
        "visual_evidence": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "table": {
      "type": "object",
      "required": ["title", "headers", "visible_rows"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "headers": { "type": "array", "items": { "type": "string" } },
        "visible_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["cells", "confidence"],
            "properties": {
              "cells": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "repeated_list": {
      "type": "object",
      "required": ["title", "item_type", "items"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "item_type": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "metadata", "confidence"],
            "properties": {
              "label": { "type": ["string", "null"] },
              "metadata": { "type": "array", "items": { "type": "string" } },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "visual_element": {
      "type": "object",
      "required": ["type", "location", "description", "associated_text", "confidence"],
      "properties": {
        "type": { "enum": ["logo", "icon", "photo", "illustration", "diagram", "chart", "map", "avatar", "other"] },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "associated_text": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "quality_flag": {
      "type": "object",
      "required": ["severity", "issue", "affected_regions"],
      "properties": {
        "severity": { "enum": ["low", "medium", "high"] },
        "issue": { "type": "string" },
        "affected_regions": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  }
}
